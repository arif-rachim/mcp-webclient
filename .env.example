# ============================================
# MCP WebClient Environment Configuration
# ============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control!

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example (Local): postgresql://postgres:password@localhost:5432/mcp_webclient
# Example (Railway): postgresql://postgres:password@containers-us-west-1.railway.app:5432/railway
DATABASE_URL="postgresql://postgres:password@localhost:5432/mcp_webclient"

# ============================================
# Authentication (NextAuth.js)
# ============================================
# NextAuth secret key (REQUIRED)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"

# NextAuth URL (your application URL)
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# MCP (Model Context Protocol) Configuration
# ============================================

# Enable client-side MCP connection (DEVELOPMENT ONLY)
# Set to 'true' to connect directly from browser to MCP server
# Set to 'false' for production (uses server-side proxy)
# WARNING: Setting to 'true' in production exposes MCP credentials!
NEXT_PUBLIC_MCP_CLIENT_SIDE=false

# MCP server URL for client-side connection (visible in browser)
# Only used when NEXT_PUBLIC_MCP_CLIENT_SIDE=true
# Example: http://localhost:8000
NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:8000

# MCP server URL for server-side connection (kept secret)
# This is used in production or when NEXT_PUBLIC_MCP_CLIENT_SIDE=false
# Can be localhost (for stdio) or remote HTTPS endpoint
MCP_SERVER_URL=http://localhost:8000

# MCP server API key (KEEP SECRET! Server-side only)
# Authentication key for MCP server (if required)
MCP_API_KEY=

# ============================================
# Ollama Configuration
# ============================================
# Ollama API endpoint
# Local development: http://localhost:11434
# Remote: https://your-ollama-server.com
OLLAMA_API_URL=http://localhost:11434

# ============================================
# Application Configuration
# ============================================
# Application public URL (for OAuth callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (development, production, test)
NODE_ENV=development

# ============================================
# Optional: Feature Flags
# ============================================
# Enable debug mode (verbose logging)
NEXT_PUBLIC_DEBUG=false

# Enable experimental features
NEXT_PUBLIC_EXPERIMENTAL_FEATURES=false

# ============================================
# Optional: Analytics & Monitoring
# ============================================
# Vercel Analytics (automatically enabled on Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Sentry DSN (error tracking)
# NEXT_PUBLIC_SENTRY_DSN=

# ============================================
# Optional: External Services
# ============================================
# OpenAI API key (if using OpenAI models in addition to Ollama)
# OPENAI_API_KEY=

# Anthropic API key (if using Claude via API)
# ANTHROPIC_API_KEY=

# ============================================
# Development Notes
# ============================================
#
# IMPORTANT:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Fill in your actual values in .env.local
# 3. NEVER commit .env.local to git!
# 4. For production, set environment variables in Vercel dashboard
#
# Required Variables for Basic Functionality:
# - DATABASE_URL (PostgreSQL connection)
# - NEXTAUTH_SECRET (for session encryption)
# - NEXTAUTH_URL (your app URL)
# - OLLAMA_API_URL (Ollama endpoint)
# - NEXT_PUBLIC_APP_URL (public app URL)
#
# Optional Variables:
# - MCP configuration (only if using MCP servers)
# - Feature flags and analytics
#
# Security Best Practices:
# - Use different credentials for development and production
# - Rotate API keys regularly
# - Use environment-specific databases
# - Never expose secrets to client (no NEXT_PUBLIC_ prefix)
# - Use HTTPS in production
#
# MCP Security:
# - NEVER set NEXT_PUBLIC_MCP_CLIENT_SIDE=true in production
# - Client-side MCP is for development only
# - Production should always use server-side MCP proxy
# - MCP_API_KEY should never be exposed to browser
#
# Database Security:
# - Use strong passwords (minimum 16 characters)
# - Enable SSL for database connections in production
# - Restrict database access by IP (firewall rules)
# - Regular automated backups
# - Use connection pooling for better performance
#
# Authentication Security:
# - NEXTAUTH_SECRET must be at least 32 characters
# - Use different secrets for dev/prod
# - Enable secure cookies in production (automatic with HTTPS)
# - Implement rate limiting on auth endpoints
#
# ============================================
